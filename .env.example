# Copy to .env only in a private deployment. Node does not auto-load .env; use your host's environment settings.
NODE_ENV=production
APP_URL=https://your-service.onrender.com
PORT=3000
DATA_DIR=/var/data/sanji
# Generate separate strong random values in the hosting settings. Keep the encryption key stable across restarts/backups.
SANJI_ENCRYPTION_KEY=
SANJI_SETUP_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep false until owner separately approves actual sending.
EMAIL_SENDING_ENABLED=false
INSTAGRAM_SENDING_ENABLED=false
# Optional integrations:
BRAVE_SEARCH_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
